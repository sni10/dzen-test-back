# The server's .env next to compose.prod.yaml (chmod 600). deploy/deploy.sh adds BACK_TAG and FRONT_TAG.
# Generate secrets, e.g.: openssl rand -base64 48 | tr -d '/+=\n'

SITE_ADDRESS=comments.<ip-with-dashes>.sslip.io

DJANGO_SECRET_KEY=<50+ random characters>
DJANGO_DEBUG=false
# 127.0.0.1: the container healthcheck calls Django directly (port 8000 is not published)
DJANGO_ALLOWED_HOSTS=comments.<ip-with-dashes>.sslip.io,127.0.0.1

DB_NAME=dzen
DB_USER=dzen
DB_PASSWORD=<random>
DB_ROOT_PASSWORD=<random>

RABBITMQ_USER=dzen
RABBITMQ_PASSWORD=<random>
