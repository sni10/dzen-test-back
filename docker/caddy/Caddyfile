# One origin for the SPA and the API. Locally SITE_ADDRESS is unset -> plain HTTP on :8080;
# on the server SITE_ADDRESS=comments.<ip-with-dashes>.sslip.io -> Caddy gets a Let's Encrypt certificate itself.
{$SITE_ADDRESS::8080} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	# Attachments straight from the shared volume (Django serves no media when DEBUG is off);
	# .txt goes out as text/plain; charset=utf-8, and nosniff keeps browsers from guessing otherwise
	handle /media/* {
		root * /srv
		file_server
	}

	@backend path /api/* /graphql /graphql/* /ws/* /admin /admin/* /static/*
	handle @backend {
		reverse_proxy app:8000
	}

	handle {
		reverse_proxy front:8080
	}
}
