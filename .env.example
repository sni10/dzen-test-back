# Local development. `docker compose up` overrides DB_HOST/DB_PORT/REDIS_URL for the app container;
# the values below are for `uv run manage.py ...` on the host.
DJANGO_SECRET_KEY=dev-only-secret-key-long-enough-to-sign-jwt-change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=dzen
DB_USER=dzen
DB_PASSWORD=dzen
DB_ROOT_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3307

REDIS_URL=redis://127.0.0.1:6380/0
RABBITMQ_URL=amqp://dzen:dzen@127.0.0.1:5673//

# Vite dev server of dzen-test-front
CORS_ALLOWED_ORIGINS=http://localhost:5173
